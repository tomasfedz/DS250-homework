name: Render Quarto Report and Deploy

on:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v2

    - name: Set up Python
      uses: actions/setup-python@v4

    - name: Install dependencies
      run: |
        pip install -r requirements.txt

    - name: Render Quarto Report
      uses: quarto-dev/quarto-actions@v2
      with:
        command: render

    - name: Upload artifact
      uses: actions/upload-pages-artifact@v2  # Use upload-pages-artifact for GitHub Pages deployments
      with:
        path: 'Projects/Project 4/'
